{
  "name": "benchme",
  "private": true,
  "version": "0.1.0",
  "description": "benchme — hosted demo sites, MCP servers and a verifier for agentic benchmarks",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
