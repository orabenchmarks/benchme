{
  "id": "cuj-return-exchange-steps-01",
  "blind": false,
  "oracle": {
    "kind": "state",
    "checks": [
      {
        "name": "returned",
        "app": "sports",
        "path": "/api/v1/returns?orderNo=ORD-10019",
        "expect": {
          "qty": 1,
          "reason": "too small"
        },
        "where": {
          "sku": "SP-115-BLK-S"
        },
        "count": {
          "min": 1,
          "max": 1
        },
        "entity": {
          "type": "return",
          "id": "{returnNo}"
        }
      }
    ]
  },
  "steps": [
    {
      "oracle": {
        "kind": "state",
        "checks": [
          {
            "name": "new size ordered",
            "app": "sports",
            "path": "/api/v1/orders?customerEmail=lior.ferrante%40example.org&status=processing",
            "expect": {
              "addressCode": "AD-1033",
              "lineCount": 1,
              "lines": {
                "sku": "SP-115-BLK-M",
                "qty": 1
              }
            },
            "where": {
              "status": "processing"
            },
            "entity": {
              "type": "order",
              "id": "{orderNo}"
            }
          }
        ]
      }
    },
    {
      "oracle": {
        "kind": "json",
        "expect": {
          "total": {
            "value": 72.94,
            "tolerance": 0.01
          }
        }
      }
    }
  ]
}
