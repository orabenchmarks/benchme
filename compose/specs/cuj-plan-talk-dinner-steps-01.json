{
  "id": "cuj-plan-talk-dinner-steps-01",
  "blind": false,
  "oracle": {
    "kind": "state",
    "checks": [
      {
        "name": "registered",
        "app": "events",
        "path": "/api/v1/registrations?email=ottilie.holloway.71041%40journeys.example",
        "expect": {
          "email": "ottilie.holloway.71041@journeys.example"
        },
        "where": {
          "eventCode": "EV-1062",
          "status": "registered"
        },
        "count": {
          "min": 1,
          "max": 1
        },
        "entity": {
          "type": "registration",
          "id": "{regNo}"
        }
      }
    ]
  },
  "steps": [
    {
      "oracle": {
        "kind": "state",
        "checks": [
          {
            "name": "table booked",
            "app": "dining",
            "path": "/api/v1/reservations?guestEmail=ottilie.holloway.71041%40journeys.example",
            "expect": {
              "time": "17:30",
              "partySize": 2,
              "area": "indoor"
            },
            "where": {
              "restaurantCode": "RS-103",
              "date": "2027-04-12",
              "status": "confirmed"
            },
            "count": {
              "min": 1,
              "max": 1
            },
            "entity": {
              "type": "reservation",
              "id": "{reservationNo}"
            }
          }
        ]
      }
    },
    {
      "oracle": {
        "kind": "json",
        "expect": {
          "deposit": {
            "value": 40,
            "tolerance": 0.01
          }
        }
      }
    }
  ]
