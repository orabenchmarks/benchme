{
  "id": "cuj-self-signup-register-01",
  "blind": false,
  "oracle": {
    "kind": "state",
    "checks": [
      {
        "kind": "ledger",
        "name": "account confirmed",
        "match": {
          "app": "events",
          "entity": {
            "type": "account",
            "id": "greer.corrigan.27821@journeys.example"
          },
          "action": "verify",
          "outcome": "ok"
        }
      },
      {
        "name": "registered",
        "app": "events",
        "path": "/api/v1/registrations?email=greer.corrigan.27821%40journeys.example",
        "expect": {
          "email": "greer.corrigan.27821@journeys.example"
        },
        "where": {
          "eventCode": "EV-1073",
          "status": "registered"
        },
        "count": {
          "min": 1,
          "max": 1
        },
        "entity": {
          "type": "registration",
          "id": "{regNo}"
        }
      },
      {
        "kind": "ledger",
        "name": "registered as them",
        "match": {
          "app": "events",
          "entity": {
            "type": "registration"
          },
          "subject": {
            "type": "event",
            "id": "EV-1073"
          },
          "action": "create",
          "outcome": "ok",
          "actor": "greer.corrigan.27821@journeys.example"
        }
      },
      {
        "kind": "unchanged",
        "name": "no change made as anyone else",
        "scope": [
          {
            "apps": [
              "events"
            ],
            "actor": "danae.larrabee@staff.example"
          },
          {
            "apps": [
              "events"
            ],
            "actor": "lior.kowalczyk@staff.example"
          },
          {
            "apps": [
              "events"
            ],
            "actor": "orrin.sandoval@staff.example"
          },
          {
            "apps": [
              "events"
            ],
            "actor": "teodor.mbeki@staff.example"
          }
        ]
      }
    ]
  },
  "steps": []
}
