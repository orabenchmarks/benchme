{
  "id": "intent-clinic-refill-cheapest-03",
  "blind": false,
  "oracle": {
    "kind": "state",
    "checks": [
      {
        "name": "refill-requested",
        "app": "clinic",
        "path": "/api/v1/refills?rxNo=RX-60021",
        "where": {
          "status": "requested"
        },
        "count": {
          "min": 1,
          "max": 1
        },
        "expect": {
          "pharmacyCode": "CL-16"
        }
      },
      {
        "name": "refills-left",
        "app": "clinic",
        "path": "/api/v1/prescriptions/RX-60021",
        "expect": {
          "refillsLeft": 1
        }
      },
      {
        "name": "RX-60061-untouched",
        "app": "clinic",
        "path": "/api/v1/prescriptions/RX-60061",
        "expect": {
          "refillsLeft": 2,
          "refillPending": false
        }
      }
    ]
  }
}
