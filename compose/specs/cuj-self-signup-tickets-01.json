{
  "id": "cuj-self-signup-tickets-01",
  "blind": false,
  "oracle": {
    "kind": "state",
    "checks": [
      {
        "kind": "ledger",
        "name": "account confirmed",
        "match": {
          "app": "cinema",
          "entity": {
            "type": "account",
            "id": "imogen.corrigan.41855@journeys.example"
          },
          "action": "verify",
          "outcome": "ok"
        }
      },
      {
        "name": "booked",
        "app": "cinema",
        "path": "/api/v1/bookings?customerEmail=imogen.corrigan.41855%40journeys.example",
        "expect": {
          "seats": "A1,A2"
        },
        "where": {
          "showtimeCode": "ST-2040",
