# Copy to .env — docker compose reads it. Every value has a LOCAL default in
# compose.yaml; change every secret before exposing benchme beyond your machine.
BENCHME_VERSION=0.4.0
BENCHME_PORT=8080
BENCHME_PUBLIC_URL=http://localhost:8080
POSTGRES_PASSWORD=benchme-local-postgres
GATEWAY_SECRET=benchme-local-gateway-secret-change-me
OPERATOR_KEY=benchme-local-operator-key-change-me
RECEIPT_SECRET=benchme-local-receipt-secret-change-me
MAIL_INTERNAL_SECRET=benchme-local-mail-secret-change-me
# Code tasks run in sibling containers through the Docker socket.
# Linux: the socket's group → `stat -c %g /var/run/docker.sock`; Docker Desktop: 0.
DOCKER_GID=0
# docker | none (refuse the socket: code tasks FAIL with a note, other oracles work)
RUNNER_KIND=docker
RUNNER_CPU=2
RUNNER_MEMORY=2Gi
RATE_CREATE_PER_HOUR=1000
