# Copy to .env — docker compose reads it. Every value has a LOCAL default in
# compose.yaml; change every secret before exposing benchme beyond your machine.
# The app image tag (ghcr.io/orabenchmarks/<app>:$BENCHME_VERSION). Bumps
# independently of charts/benchme/Chart.yaml's chart version — move it only
# once a tagged release actually publishes the images you need.
BENCHME_VERSION=0.5.0
BENCHME_PORT=8080
BENCHME_PUBLIC_URL=http://localhost:8080
# BENCHME_PUBLIC_URL must be resolvable from wherever agents run — from a k3d cluster on this host use http://host.k3d.internal:8090
POSTGRES_PASSWORD=benchme-local-postgres
GATEWAY_SECRET=benchme-local-gateway-secret-change-me
OPERATOR_KEY=benchme-local-operator-key-change-me
RECEIPT_SECRET=benchme-local-receipt-secret-change-me
MAIL_INTERNAL_SECRET=benchme-local-mail-secret-change-me
# Code tasks run in sibling containers through the Docker socket.
# Linux: the socket's group → `stat -c %g /var/run/docker.sock`; Docker Desktop: 0.
DOCKER_GID=0
# docker | none (refuse the socket: code tasks FAIL with a note, other oracles work)
RUNNER_KIND=docker
RUNNER_CPU=2
RUNNER_MEMORY=2Gi
RATE_CREATE_PER_HOUR=1000
# NLWeb ranker for warehouse/helpdesk/vaultdocs' /ask — lexical | llm | jev.
# A key missing for the SELECTED ranker fails boot rather than silently
# answering lexically (see README § Rankers). Leave LLM_API_KEY/JEV_API_KEY
# empty for the default lexical ranker.
ASK_RANKER=lexical
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_INPUT_USD_PER_MTOK=1.0
LLM_OUTPUT_USD_PER_MTOK=5.0
JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=
JEV_MODEL=jev-latest
RANKER_CONCURRENCY=8
# Per-request X-Ask-Ranker override on /ask — evaluations only (tools/ask-eval.mjs).
ASK_RANKER_OVERRIDE=0
